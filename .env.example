# Neon/Supabase-с авсан Postgres холболтын URL
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin нэвтрэх нууц үг
ADMIN_PASSWORD="солих-ёстой-нууц-үг"

# Cookie гарын үсэг зурахад ашиглах санамсаргүй тэмдэгт мөр (жишээ нь: openssl rand -hex 32)
ADMIN_SECRET="солих-ёстой-random-string"

# Сайтын үндсэн URL (линк үүсгэхэд ашиглана)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
